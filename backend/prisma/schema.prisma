generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model categories {
  category_id     BigInt            @id @default(autoincrement())
  user_id         BigInt
  name            String            @db.VarChar(100)
  category_type   transaction_type
  users           users             @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_categories_user")
  category_limits category_limits[]
  transactions    transactions[]

  @@unique([category_id, category_type], map: "uq_categories_id_type")
  @@unique([user_id, name], map: "uq_categories_user_name")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model category_limits {
  limit_id    BigInt     @id @default(autoincrement())
  user_id     BigInt
  category_id BigInt
  amount      Decimal    @db.Decimal(12, 2)
  categories  categories @relation(fields: [category_id], references: [category_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_category_limits_category")
  users       users      @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_category_limits_user")

  @@unique([user_id, category_id], map: "uq_category_limits_user_category")
  @@index([category_id], map: "idx_category_limits_category_id")
}

model credit_payments {
  payment_id     BigInt       @id @default(autoincrement())
  credit_id      BigInt
  transaction_id BigInt       @unique
  credits        credits      @relation(fields: [credit_id], references: [credit_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_credit_payments_credit")
  transactions   transactions @relation(fields: [transaction_id], references: [transaction_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_credit_payments_transaction")

  @@index([credit_id], map: "idx_credit_payments_credit_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model credits {
  credit_id       BigInt            @id @default(autoincrement())
  user_id         BigInt
  name            String            @db.VarChar(150)
  total_amount    Decimal           @db.Decimal(12, 2)
  interest_rate   Decimal?          @db.Decimal(5, 2)
  start_date      DateTime          @db.Date
  end_date        DateTime?         @db.Date
  credit_payments credit_payments[]
  users           users             @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_credits_user")

  @@index([user_id], map: "idx_credits_user_id")
}

model places {
  place_id     BigInt         @id @default(autoincrement())
  user_id      BigInt
  name         String         @db.VarChar(150)
  users        users          @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_places_user")
  transactions transactions[]

  @@unique([user_id, name], map: "uq_palces_user_name")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model transactions {
  transaction_id   BigInt           @id @default(autoincrement())
  user_id          BigInt
  category_id      BigInt
  amount           Decimal          @db.Decimal(12, 2)
  comment          String?
  transaction_date DateTime         @db.Date
  place_id         BigInt?
  type             transaction_type
  created_at       DateTime         @default(now()) @db.Timestamp(6)
  credit_payments  credit_payments?
  categories       categories       @relation(fields: [category_id, type], references: [category_id, category_type], onDelete: Cascade, onUpdate: NoAction, map: "fk_transaction_categoty_type")
  places           places?          @relation(fields: [place_id], references: [place_id], onUpdate: NoAction, map: "fk_transaction_place")
  users            users            @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_transaction_user")

  @@index([category_id], map: "idx_transaction_category_id")
  @@index([type], map: "idx_transaction_type")
  @@index([user_id], map: "idx_transaction_user_id")
  @@index([transaction_date], map: "idx_transactions_date")
  @@index([place_id], map: "idx_transactions_place_id")
}

model users {
  user_id         BigInt            @id @default(autoincrement())
  username        String            @db.VarChar(100)
  email           String            @unique @db.VarChar(255)
  password_hash   String
  created_at      DateTime          @default(now()) @db.Timestamp(6)
  categories      categories[]
  category_limits category_limits[]
  credits         credits[]
  places          places[]
  transactions    transactions[]
}

enum transaction_type {
  income
  expense
}
